<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Distress Intelligence - Admin</title>
  <style>
    body{font-family:Arial,Helvetica,sans-serif;margin:18px;background:#0b0f17;color:#eaf0ff}
    h1{font-size:18px;margin:0 0 12px}
    .bar{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin-bottom:12px}
    .field{display:flex;flex-direction:column;gap:6px}
    label{font-size:11px;opacity:.85}
    input,select{padding:8px 10px;border-radius:10px;border:1px solid #2a3a5d;background:#0c1322;color:#eaf0ff;outline:none}
    button{padding:9px 12px;border-radius:10px;border:0;background:#3b82f6;color:#fff;font-weight:700;cursor:pointer}
    button:hover{filter:brightness(1.05)}
    .ghost{background:#1b2a46}
    .meta{font-size:12px;opacity:.85;margin-left:auto}
    .wrap{border:1px solid #22304d;border-radius:14px;background:#121a2a;padding:12px}
    table{border-collapse:collapse;width:100%}
    th,td{border:1px solid #22304d;padding:6px 8px;font-size:12px;vertical-align:top}
    th{background:#0c1322;position:sticky;top:0}
    .grid{display:grid;grid-template-columns:1fr;gap:12px}
    .row2{display:flex;gap:10px;flex-wrap:wrap}
    .small{font-size:11px;opacity:.8}
    .pill{display:inline-block;padding:2px 8px;border-radius:999px;background:#0c1322;border:1px solid #22304d;font-size:11px}
  </style>
</head>
<body>
  <h1>Admin</h1>

  <div class="wrap">
    <div class="bar">
      <div class="field">
        <label>Page</label>
        <input id="page" type="number" value="1" min="1" style="width:90px"/>
      </div>

      <div class="field">
        <label>Page Size</label>
        <input id="page_size" type="number" value="25" min="1" max="2000" style="width:110px"/>
      </div>

      <div class="field">
        <label>Still Delinquent</label>
        <select id="still">
          <option value="">(any)</option>
          <option value="true">true</option>
          <option value="false">false</option>
        </select>
      </div>

      <div class="field">
        <label>Min Due</label>
        <input id="min_due" type="number" value="" placeholder="0" style="width:120px"/>
      </div>

      <div class="field" style="min-width:240px">
        <label>Search (parcel / owner / address)</label>
        <input id="q" type="text" value="" placeholder="e.g. 038753-0000 or DEVONSHIRE"/>
      </div>

      <button onclick="loadRows()">Load</button>
      <button class="ghost" onclick="rebuild()">Rebuild CSV</button>
      <button class="ghost" onclick="downloadCsv()">Download CSV</button>

      <div class="meta" id="meta"></div>
    </div>

    <div class="row2">
      <div class="field">
        <label>Saved Searches</label>
        <select id="saved" onchange="applySaved()">
          <option value="">(select)</option>
        </select>
      </div>
      <button class="ghost" onclick="saveCurrent()">Save Current Filters</button>
      <button class="ghost" onclick="deleteSaved()">Delete Saved</button>
      <span class="small" id="saveNote"></span>
    </div>

    <div class="grid" style="margin-top:12px">
      <div style="overflow:auto;max-height:70vh">
        <table>
          <thead>
            <tr>
              <th>Parcel</th>
              <th>Address</th>
              <th>Zip</th>
              <th>Face Amount</th>
              <th>Live Total Due</th>
              <th>Still Delinquent</th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </div>

    <div class="small" style="margin-top:10px">
      Tip: Use <span class="pill">Still Delinquent = true</span> to see the real targets.
    </div>
  </div>

<script>
function qs(){
  const page = document.getElementById("page").value || "1";
  const page_size = document.getElementById("page_size").value || "25";
  const still = document.getElementById("still").value;
  const q = (document.getElementById("q").value || "").trim();
  const min_due = (document.getElementById("min_due").value || "").trim();

  let url = `/api/delinquent?page=${encodeURIComponent(page)}&page_size=${encodeURIComponent(page_size)}`;
  if(still) url += `&still=${encodeURIComponent(still)}`;
  if(q) url += `&q=${encodeURIComponent(q)}`;
  if(min_due) url += `&min_due=${encodeURIComponent(min_due)}`;
  return url;
}

async function loadRows(){
  const url = qs();
  const res = await fetch(url);
  const txt = await res.text();
  if(!res.ok){ alert(txt); return; }
  const data = JSON.parse(txt);

  document.getElementById("meta").textContent = `total=${data.total} returned=${data.returned} page=${data.page || ''}`;

  const tb = document.getElementById("tbody");
  tb.innerHTML = "";
  (data.rows || []).forEach(r=>{
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td>${r.lienhub_account_no || ""}</td>
      <td>${r.lienhub_situs_address || ""}</td>
      <td>${(r.lienhub_situs_zip || r.live_zip || "")}</td>
      <td>${r.lienhub_face_amount || ""}</td>
      <td>${r.live_total_due || ""}</td>
      <td>${r.still_delinquent}</td>
    `;
    tb.appendChild(tr);
  });
}

async function rebuild(){
  const res = await fetch("/api/rebuild_delinquent", {method:"POST"});
  const txt = await res.text();
  if(!res.ok){ alert(txt); return; }
  alert(txt);
  await loadRows();
}

function downloadCsv(){
  const page = document.getElementById("page").value || "1";
  const page_size = document.getElementById("page_size").value || "500";
  const still = document.getElementById("still").value;
  const q = (document.getElementById("q").value || "").trim();
  const min_due = (document.getElementById("min_due").value || "").trim();

  let url = `/api/delinquent.csv?page=${encodeURIComponent(page)}&page_size=${encodeURIComponent(page_size)}`;
  if(still) url += `&still=${encodeURIComponent(still)}`;
  if(q) url += `&q=${encodeURIComponent(q)}`;
  if(min_due) url += `&min_due=${encodeURIComponent(min_due)}`;
  window.open(url, "_blank");
}

function loadSavedList(){
  const sel = document.getElementById("saved");
  const saved = JSON.parse(localStorage.getItem("di_saved_searches") || "[]");
  sel.innerHTML = '<option value="">(select)</option>';
  saved.forEach((s,i)=>{
    const opt = document.createElement("option");
    opt.value = String(i);
    opt.textContent = s.name;
    sel.appendChild(opt);
  });
}

function currentState(){
  return {
    page: document.getElementById("page").value || "1",
    page_size: document.getElementById("page_size").value || "25",
    still: document.getElementById("still").value || "",
    q: (document.getElementById("q").value || "").trim(),
    min_due: (document.getElementById("min_due").value || "").trim()
  };
}

function saveCurrent(){
  const name = prompt("Name this saved search:");
  if(!name) return;
  const saved = JSON.parse(localStorage.getItem("di_saved_searches") || "[]");
  saved.push({name, state: currentState()});
  localStorage.setItem("di_saved_searches", JSON.stringify(saved));
  document.getElementById("saveNote").textContent = "Saved.";
  loadSavedList();
}

function applySaved(){
  const idx = document.getElementById("saved").value;
  if(idx === "") return;
  const saved = JSON.parse(localStorage.getItem("di_saved_searches") || "[]");
  const s = saved[Number(idx)];
  if(!s) return;
  document.getElementById("page").value = s.state.page || "1";
  document.getElementById("page_size").value = s.state.page_size || "25";
  document.getElementById("still").value = s.state.still || "";
  document.getElementById("q").value = s.state.q || "";
  document.getElementById("min_due").value = s.state.min_due || "";
  loadRows();
}

function deleteSaved(){
  const idx = document.getElementById("saved").value;
  if(idx === "") return;
  const saved = JSON.parse(localStorage.getItem("di_saved_searches") || "[]");
  saved.splice(Number(idx), 1);
  localStorage.setItem("di_saved_searches", JSON.stringify(saved));
  document.getElementById("saveNote").textContent = "Deleted.";
  loadSavedList();
}

loadSavedList();
loadRows();
</script>
<script>
(function(){
  function hideGate(){
    const sels = [
      "#adminGate","#adminModal","#adminLogin",
      ".modal",".overlay",".backdrop",".dialog",
      "[data-admin-gate]","[data-modal]","[aria-modal='true']"
    ];
    sels.forEach(s => document.querySelectorAll(s).forEach(el => { el.style.display="none"; el.removeAttribute("aria-hidden"); }));
    document.querySelectorAll("body *").forEach(el=>{
      if(el && el.style && (el.style.position==="fixed" || el.style.position==="sticky")){
        // do nothing
      }
    });
    document.body.style.overflow="auto";
  }

  document.addEventListener("click", function(e){
    const el = e.target && e.target.closest ? e.target.closest("button,a,input") : e.target;
    if(!el) return;

    const txt = (el.textContent || el.value || "").trim().toLowerCase();
    const idc = ((el.id||"") + " " + (el.className||"") + " " + (el.getAttribute && (el.getAttribute("data-action")||""))).toLowerCase();

    if(txt === "skip" || idc.includes("skip")){
      e.preventDefault();
      e.stopPropagation();
      hideGate();
    }
  }, true);

  document.addEventListener("keydown", function(e){
    if(e.key === "Escape"){ hideGate(); }
  }, true);

  // run once on load too
  window.addEventListener("load", hideGate);
})();
</script>
</body>
</html>
<script>
document.addEventListener("click", function(e){
  const b = e.target && e.target.closest && e.target.closest("button");
  if(!b) return;
  if((b.textContent||"").trim().toLowerCase() !== "skip") return;
  e.preventDefault();
  e.stopPropagation();
  const candidates = [
    document.querySelector("#adminGate"),
    document.querySelector("#adminModal"),
    document.querySelector("#adminLogin"),
    document.querySelector(".modal"),
    document.querySelector(".overlay"),
    document.querySelector("[data-admin-gate]")
  ].filter(Boolean);
  candidates.forEach(el => el.style.display = "none");
});
</script>

