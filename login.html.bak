<!doctype html>
<html>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Distress Intelligence - Login</title>
  <style>
    body{font-family:Arial,Helvetica,sans-serif;background:#0b0f17;color:#eaf0ff;margin:0}
    .wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px}
    .card{width:100%;max-width:420px;background:#121a2a;border:1px solid #22304d;border-radius:14px;padding:18px 18px 14px;box-shadow:0 10px 30px rgba(0,0,0,.35)}
    h1{font-size:18px;margin:0 0 10px}
    .sub{font-size:12px;opacity:.8;margin:0 0 14px}
    label{font-size:12px;opacity:.9}
    input{width:100%;padding:10px 12px;border-radius:10px;border:1px solid #2a3a5d;background:#0c1322;color:#eaf0ff;outline:none;margin-top:6px}
    button{width:100%;padding:10px 12px;border-radius:10px;border:0;background:#3b82f6;color:white;font-weight:700;cursor:pointer;margin-top:12px}
    button:hover{filter:brightness(1.05)}
    .msg{margin-top:10px;font-size:12px;white-space:pre-wrap}
    .row{display:flex;gap:8px;margin-top:10px}
    .ghost{background:#1b2a46}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <h1>Distress Intelligence</h1>
      <p class="sub">Admin access</p>

      <label>Admin Password</label>
      <input id="pw" type="password" placeholder="Enter password (if enabled)" />

      <div class="row">
        <button class="ghost" type="button" onclick="goAdmin()">Skip</button>
        <button type="button" onclick="doLogin()">Login</button>
      </div>

      <div id="msg" class="msg"></div>
    </div>
  </div>

<script>
function setMsg(t){ document.getElementById('msg').textContent = t || ''; }

function goAdmin(){ window.location.href = "/admin.html"; }

async function doLogin(){
  setMsg("");
  const password = document.getElementById('pw').value || "";
  const res = await fetch("/api/login", {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({password})
  });
  const txt = await res.text();
  if(res.ok){
    goAdmin();
    return;
  }
  setMsg(txt);
}
</script>
</body>
</html>
